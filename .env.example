# Root folder where series and movies are organized
ROOT_FOLDER=/home/strubloid/stremio-downloads

# Real-Debrid API key (required for actual downloads - get from https://real-debrid.com/apitoken)
REAL_DEBRID_API_KEY=

# HDHub debrid key (TorBox API key, UUID-format like
# xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx) — optional.
# Without this, HDHub returns HLS manifest placeholders that Stremio's
# player can handle but py-stremio's downloader cannot (the manifest is
# ~480 bytes pointing at an external CDN). Setting a TorBox key makes
# HDHub return direct video URLs that py-stremio can save as files.
# Get your key at https://torbox.app/settings -> API
# HDHUB_DEBRID_KEY=

# Stremio addon URL for finding streams
# For full functionality (anime + debrid links), configure at https://torrentio.strem.fun
# then copy your personalized addon URL (looks like: https://torrentio.strem.fun/realdebrid/xxxx/manifest.json)
# Leave empty to use default torrentio
STREMIO_ADDON_URL=

# Maximum download attempts per item (retry rounds)
MAX_DOWNLOAD_ATTEMPTS=5

# Parallel episode downloads for py-stremio. Interactive mode reads this silently.
# py-stremio-cron uses the same code path with cron preset defaults (5 threads, 80% speed).
DOWNLOAD_THREADS=1

# Seconds without any bytes before aborting a stalled download and falling
# through to the next stream.  Uses httpx's read timeout under the hood.
# Set to 0 to disable (rely on the 5-minute request timeout instead).
DOWNLOAD_STALL_TIMEOUT=60

# Full-run metadata cache age in hours. Option 1 / --run skips Cinemeta refresh
# for folders checked recently; option 2 / --metadata still forces a refresh.
METADATA_CACHE_HOURS=24

# Bandwidth cap as a percentage of INTERNET_MAX_SPEED_MBPS.
# INTERNET_SPEED_LIMIT=100 disables throttling. INTERNET_SPEED_LIMIT=50 uses half.
INTERNET_SPEED_LIMIT=100

# Your line's maximum download speed in megabits/sec, used to calculate the cap.
# If omitted from .env, py-stremio runs one short speed probe and appends the measured value.
# Example: 200 Mbps line + INTERNET_SPEED_LIMIT=50 => ~100 Mbps cap.
INTERNET_MAX_SPEED_MBPS=100

# Dry run mode (true/false) - when true, no actual downloads occur
DRY_RUN=true

# Per-host rate-limit cap. py-stremio limits each addon host to N requests
# inside a sliding R-second window to avoid 429 cascades on a single popular
# host. The default (50 requests per 5 minutes) is well within the limits
# reported by Stremio addon operators. Set PY_STREMIO_RATE_LIMIT_CAP=0 to
# disable the cap entirely — useful when debugging "Stremio has streams but
# py-stremio does not" issues, since a stale rate-limit window would otherwise
# be the first thing to suspect.
# PY_STREMIO_RATE_LIMIT_CAP=50
# PY_STREMIO_RATE_LIMIT_WINDOW=300

# Preferred content languages (comma-separated). Filters out streams whose
# titles only mention non-preferred languages. Use "any" to disable filtering.
# Default: english
# Example: PREFERRED_LANGUAGES=english,spanish
PREFERRED_LANGUAGES=english

# Local torrent proxy URL (optional). When set, info-hash streams are first
# tried through this proxy for fast RD-cached content resolution, falling
# back to the full RealDebrid API if the proxy is unavailable or stalls.
# Example: TORRENT_PROXY_URL=http://127.0.0.1:11470
# TORRENT_PROXY_URL=

# SMTP settings for email reports (optional)
# Leave empty to disable email reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
