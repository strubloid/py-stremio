# Root folder where series and movies are organized
ROOT_FOLDER=/home/strubloid/stremio-downloads

# Real-Debrid API key (required for actual downloads - get from https://real-debrid.com/apitoken)
REAL_DEBRID_API_KEY=

# Stremio addon URL for finding streams
# For full functionality (anime + debrid links), configure at https://torrentio.strem.fun
# then copy your personalized addon URL (looks like: https://torrentio.strem.fun/realdebrid/xxxx/manifest.json)
# Leave empty to use default torrentio
STREMIO_ADDON_URL=

# Maximum download attempts per item
MAX_DOWNLOAD_ATTEMPTS=2

# Dry run mode (true/false) - when true, no actual downloads occur
DRY_RUN=true

# SMTP settings for email reports (optional)
# Leave empty to disable email reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true