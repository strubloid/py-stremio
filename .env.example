# Root folder where series and movies are organized
ROOT_FOLDER=/home/strubloid/stremio-downloads

# Real-Debrid API key (optional - leave empty for mock mode)
REAL_DEBRID_API_KEY=

# Maximum download attempts per item
MAX_DOWNLOAD_ATTEMPTS=2

# Dry run mode (true/false) - when true, no actual downloads occur
DRY_RUN=true

# SMTP settings for email reports (optional)
# Leave empty to disable email reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true